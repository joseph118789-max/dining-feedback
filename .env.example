# Database
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/dining_feedback
POSTGRES_USER=dining_user
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=dining_feedback

# Supabase (self-hosted)
SUPABASE_URL=https://feedback.yourdomain.com
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_KEY=your_service_key_here
SUPABASE_JWT_SECRET=your_jwt_secret_here

# App URLs
BACKEND_URL=https://feedback.yourdomain.com
FRONTEND_URL=https://feedback.yourdomain.com

# Session
SESSION_SECRET=your_random_session_secret_minimum_32_chars

# Google OAuth (deprecated - Supabase Auth is used instead)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=https://feedback.yourdomain.com/api/auth/callback
