# ============================================================
# Dining Feedback System — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# DO NOT commit .env to version control.
# ============================================================

# ---- PostgreSQL Database ----
POSTGRES_USER=dining_user
POSTGRES_PASSWORD=change_me_to_a_secure_password
POSTGRES_DB=dining_feedback

# Connection string for the backend.
# Hostname MUST be "db" (matches the Docker Compose service name).
DATABASE_URL=postgresql://dining_user:change_me_to_a_secure_password@db:5432/dining_feedback

# ---- Google OAuth ----
# Create OAuth credentials at: https://console.cloud.google.com/
# 1. Go to "Credentials" → "Create Credentials" → "OAuth Client ID"
# 2. Application type: "Web application"
# 3. Add an Authorized redirect URI, e.g. http://localhost:3000/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ---- JWT ----
# Generate a strong random string (32+ chars). Example:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_this_with_a_random_32_char_or_longer_secret

# ---- Session ----
# Separate secret for express-session (can be same as JWT_SECRET for dev)
SESSION_SECRET=replace_this_with_a_session_secret_at_least_32_chars

# ---- OAuth ----
# Your Google OAuth Client Secret (from Google Cloud Console)
GOOGLE_CLIENT_SECRET=your_google_client_secret

# OAuth callback URL (must match Google Cloud Console redirect URI)
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# ---- Frontend URL (for OAuth redirect) ----
FRONTEND_URL=http://localhost:8080
